---
import { useTranslations } from "../utils/i18n";
import { defaultLang, ui } from "../i18n/ui";

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;
const t = useTranslations(lang);

const stats = [
  { value: 100, suffix: "%", label: t("stats.custom") },
  { value: 3, suffix: "", label: t("stats.platforms") },
  { value: 2, suffix: "", label: t("stats.languages") },
  { value: 0, suffix: "€", label: t("stats.free") },
];
---

<section class="relative py-20 md:py-28">
  <div class="container mx-auto px-6">
    <div data-reveal="stagger" class="grid grid-cols-2 lg:grid-cols-4 border-y border-white/10">
      {
        stats.map((s, i) => (
          <div
            class:list={[
              "py-10 md:py-14 px-4 md:px-8 border-white/10",
              i % 2 === 0 ? "border-r" : "lg:border-r",
              i < 2 ? "border-b lg:border-b-0" : "",
              i === 3 ? "lg:border-r-0" : "",
            ]}
          >
            <div class="font-display font-black tracking-[-0.04em] text-[clamp(2.75rem,6vw,5.5rem)] leading-none text-gradient whitespace-nowrap">
              <span data-counter={s.value}>{s.value}</span>{s.suffix}
            </div>
            <p class="mt-4 text-gray-400 text-sm md:text-base">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
