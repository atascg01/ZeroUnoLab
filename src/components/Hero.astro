---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../utils/i18n";
import { defaultLang, ui } from "../i18n/ui";

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;
const t = useTranslations(lang);
---

<section
  id="hero"
  data-scene-state="0"
  class="min-h-[100svh] flex flex-col justify-center relative overflow-hidden pt-28 pb-24"
>
  <div data-hero-content class="container mx-auto px-6 relative z-10">
    <div class="max-w-5xl">
      <div
        data-hero-eyebrow
        class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 backdrop-blur-md pl-2 pr-4 py-1.5 mb-8 text-xs md:text-sm text-gray-300"
      >
        <span class="relative flex h-6 w-6 items-center justify-center rounded-full bg-neon-blue/15">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-neon-blue/40"></span>
          <span class="relative h-2 w-2 rounded-full bg-neon-blue"></span>
        </span>
        {t("hero.eyebrow")}
      </div>

      <h1
        class="font-display font-black tracking-[-0.04em] leading-[0.92] text-[clamp(3rem,10.5vw,8.5rem)] [perspective:600px]"
      >
        <span data-hero-line class="split-line">{t("hero.line1")}</span>
        <span data-hero-line data-no-split class="split-line">
          <span class="inline-block text-gradient pr-2">{t("hero.line2")}</span>
        </span>
        <span data-hero-line class="split-line text-outline">{t("hero.line3")}</span>
      </h1>

      <p
        data-hero-sub
        class="mt-8 text-lg md:text-2xl text-gray-300 max-w-xl tracking-wide font-light min-h-[3.5em] md:min-h-[2.5em]"
      >
        {t("hero.subtitle")}
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <a
          href="#contact"
          data-hero-cta
          data-magnetic="0.4"
          data-cursor="Go"
          class="group relative inline-flex items-center justify-center gap-3 px-8 py-5 rounded-full bg-white text-dark-bg font-bold overflow-hidden shadow-[0_0_40px_rgba(0,194,255,0.35)]"
        >
          <span
            class="absolute inset-0 bg-gradient-to-r from-neon-blue via-neon-purple to-neon-pink scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-500 ease-[cubic-bezier(.7,0,.3,1)]"
          ></span>
          <span data-magnetic-inner class="relative flex items-center gap-3 group-hover:text-white transition-colors duration-500">
            {t("hero.startProject")}
            <Icon name="lucide:arrow-up-right" class="w-5 h-5 transition-transform duration-500 group-hover:rotate-45" />
          </span>
        </a>
        <a
          href="#services"
          data-hero-cta
          data-magnetic="0.3"
          class="group relative inline-flex items-center justify-center gap-3 px-8 py-5 rounded-full border border-white/20 text-white font-medium backdrop-blur-sm hover:border-white/60 transition-colors duration-300"
        >
          <span data-magnetic-inner class="relative flex items-center gap-3">
            {t("hero.viewServices")}
            <Icon name="lucide:arrow-down" class="w-5 h-5 transition-transform duration-500 group-hover:translate-y-1" />
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom meta row -->
  <div class="absolute bottom-8 inset-x-0 z-10">
    <div class="container mx-auto px-6 flex items-end justify-between text-xs font-mono text-gray-500">
      <div data-hero-meta class="hidden md:flex flex-col gap-1">
        <span>[ 0 , 1 ]</span>
        <span>WEB · iOS · ANDROID</span>
      </div>
      <a href="#services" data-hero-meta class="flex flex-col items-center gap-3 mx-auto md:mx-0 uppercase tracking-[0.3em]">
        {t("hero.scroll")}
        <span class="relative block w-px h-14 bg-white/10 overflow-hidden">
          <span class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-transparent to-neon-blue animate-[scroll-line_1.8s_cubic-bezier(.7,0,.3,1)_infinite]"></span>
        </span>
      </a>
      <div data-hero-meta class="hidden md:flex flex-col gap-1 items-end">
        <span>ZEROUNO LAB</span>
        <span>©{new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(200%);
    }
  }
</style>
