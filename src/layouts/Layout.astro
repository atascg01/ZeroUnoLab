---
import { useTranslations } from "../utils/i18n";
import { defaultLang, ui } from "../i18n/ui";
import Analytics from "@vercel/analytics/astro";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/900.css";
import "@fontsource/inter/900.css";
import "../styles/global.css";
import interBlack from "@fontsource/inter/files/inter-latin-900-normal.woff2?url";
import outfitLight from "@fontsource/outfit/files/outfit-latin-300-normal.woff2?url";
import outfitRegular from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="dark is-loading">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={t("meta.description")} />
		<meta name="theme-color" content="#050510" />
		<meta property="og:title" content={t("meta.title")} />
		<meta property="og:description" content={t("meta.description")} />
		<meta property="og:type" content="website" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href="/favicon-32x32.png"
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link rel="manifest" href="/site.webmanifest" />
		<!-- Fonts used above the fold, so the hero doesn't wait on the CSS to discover them -->
		<link rel="preload" href={interBlack} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={outfitRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={outfitLight} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{t("meta.title")}</title>
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body class="bg-dark-bg text-white antialiased relative">
		<!-- Preloader -->
		<div
			id="preloader"
			class="fixed inset-0 z-[90] hidden [.js_&]:block pointer-events-none"
			aria-hidden="true"
		>
			<div
				data-loader-panel="top"
				class="absolute inset-x-0 top-0 h-1/2 bg-dark-bg"
			>
			</div>
			<div
				data-loader-panel="bottom"
				class="absolute inset-x-0 bottom-0 h-1/2 bg-dark-bg"
			>
			</div>
			<div
				data-loader-inner
				class="absolute inset-0 flex flex-col items-center justify-center gap-6 px-6"
			>
				<div class="text-sm tracking-[0.4em] uppercase text-gray-500">
					ZERO<span class="text-neon-blue">UNO</span>
					<span class="text-neon-pink">LAB</span>
				</div>
				<div
					data-loader-count
					class="font-display font-black text-[22vw] md:text-[12rem] leading-none tabular-nums text-gradient"
				>
					000
				</div>
				<div class="w-64 max-w-full h-px bg-white/10 overflow-hidden">
					<div
						data-loader-bar
						class="h-full bg-gradient-to-r from-neon-blue via-neon-purple to-neon-pink origin-left scale-x-0"
					>
					</div>
				</div>
				<div class="flex flex-col items-center gap-2 font-mono text-xs text-gray-500">
					<span data-loader-bits class="tracking-[0.3em]">010011010101</span>
					<span class="uppercase tracking-[0.3em]">{t("loader.text")}</span>
				</div>
			</div>
		</div>

		<!-- Ambient gradient (also the fallback when WebGL is unavailable) -->
		<div class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true">
			<div
				class="absolute -top-1/4 -left-1/4 w-[70vw] h-[70vw] rounded-full bg-neon-purple/10 blur-[140px]"
			>
			</div>
			<div
				class="absolute -bottom-1/4 -right-1/4 w-[60vw] h-[60vw] rounded-full bg-neon-blue/10 blur-[140px]"
			>
			</div>
		</div>

		<canvas
			id="webgl"
			class="fixed inset-0 w-full h-full z-0 pointer-events-none"
			aria-hidden="true"></canvas>

		<!-- Vignette keeps text readable over particles -->
		<div
			class="fixed inset-0 z-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_40%,rgba(5,5,16,0.85)_100%)]"
			aria-hidden="true"
		>
		</div>

		<div class="grain" aria-hidden="true"></div>
		<div class="cursor-dot" aria-hidden="true"></div>
		<div class="cursor-ring" aria-hidden="true">
			<span class="cursor-label"></span>
		</div>

		<!-- Main Content Slot -->
		<div class="relative z-10">
			<slot />
		</div>
		<Analytics />
	</body>
</html>

<script>
	import "../scripts/motion";
</script>
